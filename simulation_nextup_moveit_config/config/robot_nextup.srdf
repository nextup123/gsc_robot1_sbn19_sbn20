<?xml version="1.0" encoding="UTF-8"?>
<!--
  SRDF for robot_nextup.
  Collision matrix expanded to cover the world/ground_link fixed frames and all
  never-collide pairs. Regenerate in the Setup Assistant if you change geometry,
  but this list is a correct starting point for the current URDF.
-->
<robot name="robot_nextup">

    <group name="robot_manipulator">
        <joint name="joint1"/>
        <joint name="joint2"/>
        <joint name="joint3"/>
        <joint name="joint4"/>
        <joint name="joint5"/>
        <joint name="joint6"/>
        <joint name="end"/>
    </group>

    <group_state name="home" group="robot_manipulator">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0"/>
        <joint name="joint3" value="0"/>
        <joint name="joint4" value="0"/>
        <joint name="joint5" value="0"/>
        <joint name="joint6" value="0"/>
    </group_state>

    <!-- Fixed-frame pairs: world / ground_link / base_link never move relative
         to each other, so disable all their collision checks. -->
    <disable_collisions link1="world" link2="ground_link" reason="Adjacent"/>
    <disable_collisions link1="world" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="ground_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="ground_link" link2="link1" reason="Never"/>
    <disable_collisions link1="world" link2="link1" reason="Never"/>

    <!-- Adjacent links in the chain -->
    <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>

    <!-- Never-collide pairs (one link apart, geometry can't reach) -->
    <disable_collisions link1="base_link" link2="link2" reason="Never"/>
    <disable_collisions link1="link1" link2="link3" reason="Never"/>
    <disable_collisions link1="link2" link2="link4" reason="Never"/>
    <disable_collisions link1="link3" link2="link5" reason="Never"/>
    <disable_collisions link1="link4" link2="link6" reason="Never"/>
</robot>
